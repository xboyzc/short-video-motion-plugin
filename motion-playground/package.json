{
  "name": "motion-playground",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:layout": "node scripts/test_effect_layout.mjs",
    "test:catalog": "node scripts/test_effect_catalog.mjs",
    "test:import": "node --experimental-strip-types scripts/test_overlay_import.ts",
    "test:safety": "node --experimental-strip-types scripts/test_overlay_safety.ts"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
